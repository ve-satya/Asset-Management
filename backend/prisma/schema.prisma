  id               Int      @id @default(autoincrement())
  assetId          Int      @map("asset_id")
  product          String?
  serialNumber     String?  @map("serial_number")
  installedDate    String?  @map("installed_date")
  manufacturer     String?
  model            String?
  version          String?
  partNumber       String?  @map("part_number")
  primaryBusType   String?  @map("primary_bus_type")
  secondaryBusType String?  @map("secondary_bus_type")
  deviceStatus     String?  @map("device_status")
  description      String?
  createdOn        DateTime @default(now()) @map("created_on")
  updatedOn        DateTime @updatedAt @map("updated_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_motherboards")
}

model AssetMouse {
  id           Int      @id @default(autoincrement())
  assetId      Int      @map("asset_id")
  mouseType    String?  @map("mouse_type")
  mouseButtons String?  @map("mouse_buttons")
  serialNumber String?  @map("serial_number")
  manufacturer String?
  createdOn    DateTime @default(now()) @map("created_on")
  updatedOn    DateTime @updatedAt @map("updated_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_mice")
}

model AssetMemoryModule {
  id           Int      @id @default(autoincrement())
  assetId      Int      @map("asset_id")
  moduleTag    String?  @map("module_tag")
  memoryType   String?  @map("memory_type")
  capacity     String?
  socket       String?
  bankLabel    String?  @map("bank_label")
  frequencyMhz String?  @map("frequency_mhz")
  createdOn    DateTime @default(now()) @map("created_on")
  updatedOn    DateTime @updatedAt @map("updated_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_memory_modules")
}

model AssetUserAccount {
  id          Int      @id @default(autoincrement())
  assetId     Int      @map("asset_id")
  accountName String?  @map("account_name")
  domainName  String?  @map("domain_name")
  fullName    String?  @map("full_name")
  description String?
  status      String?
  sid         String?
  createdOn   DateTime @default(now()) @map("created_on")
  updatedOn   DateTime @updatedAt @map("updated_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_user_accounts")
}

