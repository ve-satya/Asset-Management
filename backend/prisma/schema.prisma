  updatedOn     DateTime @updatedAt @map("updated_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_sound_cards")
}

model AssetDepreciationConfig {
  id                  Int      @id @default(autoincrement())
  assetId             Int      @unique @map("asset_id")
  purchaseCost        Float    @map("purchase_cost")
  acquisitionDate     DateTime @map("acquisition_date")
  method              String
  calculationMode     String?  @map("calculation_mode")
  usefulLifeMonths    Int?     @map("useful_life_months")
  depreciationPercent Float?   @map("depreciation_percent")
  salvageValue        Float?   @map("salvage_value")
  configuredBy        String?  @map("configured_by")
  configuredOn        DateTime @default(now()) @map("configured_on")
  updatedAt           DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_depreciation_configs")
}

model AssetAttachment {
  id             Int      @id @default(autoincrement())
  assetId        Int      @map("asset_id")
  originalName   String   @map("original_name")
  storedFilename String   @map("stored_filename")
  mimeType       String?  @map("mime_type")
  fileSize       Int      @map("file_size")
  uploadedBy     String?  @map("uploaded_by")
  uploadedOn     DateTime @default(now()) @map("uploaded_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, uploadedOn])
  @@map("asset_attachments")
}

model AssetContract {
  id                Int       @id @default(autoincrement())
  assetId           Int       @map("asset_id")
  contractId        String    @map("contract_id")
  contractName      String    @map("contract_name")
  maintenanceVendor String?   @map("maintenance_vendor")
  fromDate          DateTime? @map("from_date")
  toDate            DateTime? @map("to_date")
  createdOn         DateTime  @default(now()) @map("created_on")
  createdBy         String?   @map("created_by")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_contracts")
}

model AssetCost {
  id          Int      @id @default(autoincrement())
  assetId     Int      @map("asset_id")
  costFactor  String   @map("cost_factor")
  costAmount  Float    @map("cost_amount")
  description String?
  costDate    DateTime? @map("cost_date")
  createdOn   DateTime @default(now()) @map("created_on")
  createdBy   String?  @map("created_by")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_costs")
}

model Software {
  id                 Int      @id @default(autoincrement())
  name               String   @map("software_name")
  version            String?
  softwareTypeId     Int      @map("software_type_id")
  softwareCategoryId Int      @map("software_category_id")
  manufacturerId     Int      @map("manufacturer_id")
  licenseTypeId      Int?     @map("license_type_id")
  description        String?
  images             Json     @default("[]")
  isSoftwareSuite    Boolean  @default(false) @map("is_software_suite")
  cost               Float?
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  softwareType      SoftwareType               @relation(fields: [softwareTypeId], references: [id])
  softwareCategory  SoftwareCategory           @relation(fields: [softwareCategoryId], references: [id])
  manufacturer      Manufacturer               @relation(fields: [manufacturerId], references: [id])
  licenseType       SoftwareLicenseType?       @relation(fields: [licenseTypeId], references: [id])
  licenses          SoftwareLicense[]
  installations     SoftwareInstallation[]
  licenseAgreements SoftwareLicenseAgreement[]
  servicePacks      ServicePack[]

  @@map("softwares")
}

model SoftwareLicense {
  id                   Int       @id @default(autoincrement())
  softwareId           Int       @map("software_id")
  licenseKey           String?   @map("license_key")
  licenseType          String?   @map("license_type")
  licenseOption        String?   @map("license_option")
  purchased            Int       @default(0)
  installationsAllowed Int       @default(0) @map("installations_allowed")
  allocated            Int       @default(0)
  available            Int       @default(0)
  purchaseCost         Float?    @map("purchase_cost")
  acquiredDate         DateTime? @map("acquired_date")
  expiryDate           DateTime? @map("expiry_date")
  purchasedFor         String?   @map("purchased_for")
  allocatedSite        String?   @map("allocated_site")
  isCritical           Boolean   @default(false) @map("is_critical")
  vendorId             Int?      @map("vendor_id")
  agreementId          Int?      @map("agreement_id")
  downgradeRights      Json      @default("[]") @map("downgrade_rights")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  software      Software                  @relation(fields: [softwareId], references: [id])
  installations SoftwareInstallation[]
  vendor        Vendor?                   @relation(fields: [vendorId], references: [id])
  agreement     SoftwareLicenseAgreement? @relation(fields: [agreementId], references: [id])

  @@map("software_licenses")
}

model SoftwareInstallation {
  id           Int       @id @default(autoincrement())
  softwareId   Int       @map("software_id")
  computerName String?   @map("computer_name")
  userName     String?   @map("user_name")
  version      String?
  licenseId    Int?      @map("license_id")
  installedOn  DateTime? @map("installed_on")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  software Software          @relation(fields: [softwareId], references: [id])
  license  SoftwareLicense?  @relation(fields: [licenseId], references: [id])

  @@map("software_installations")
}

model SoftwareLicenseAgreement {
  id                  Int       @id @default(autoincrement())
  softwareId          Int?      @map("software_id")
  manufacturerId      Int?      @map("manufacturer_id")
  agreementName       String    @map("agreement_name")
  authorizationNumber String?   @map("authorization_number")
  vendorId            Int?      @map("vendor_id")
  startDate           DateTime? @map("start_date")
  endDate             DateTime? @map("end_date")
  documentUrl         String?   @map("document_url")
  poNumber            String?   @map("po_number")
  poName              String?   @map("po_name")
  purchaseDate        DateTime? @map("purchase_date")
  purchaseDescription String?   @map("purchase_description")
  invoiceNumber       String?   @map("invoice_number")
  invoiceDate         DateTime? @map("invoice_date")
  totalCost           Float?    @map("total_cost")
  terms               String?
  notifyBeforeDays    Int?      @map("notify_before_days")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  software     Software?      @relation(fields: [softwareId], references: [id])
  manufacturer Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  vendor       Vendor?        @relation(fields: [vendorId], references: [id])
  licenses     SoftwareLicense[]

  @@map("software_license_agreements")
}

model ServicePack {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  isInstalled    Boolean  @default(false) @map("is_installed")
  softwareId     Int?     @map("software_id")
  manufacturerId Int?     @map("manufacturer_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  software     Software?     @relation(fields: [softwareId], references: [id])
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])

  @@map("service_packs")
}

model AssetRelationship {
  id               Int      @id @default(autoincrement())
  parentAssetId    Int      @map("parent_asset_id")
  relatedAssetId   Int      @map("related_asset_id")
  relationshipType String   @map("relationship_type")
  createdBy        String?  @map("created_by")
  createdOn        DateTime @default(now()) @map("created_on")

  parentAsset  Asset @relation("ParentAssetRelationship", fields: [parentAssetId], references: [id], onDelete: Cascade)
  relatedAsset Asset @relation("RelatedAssetRelationship", fields: [relatedAssetId], references: [id], onDelete: Cascade)

  @@index([parentAssetId, relationshipType])
  @@map("asset_relationships")
}

model AssetServiceRelationship {
  id               Int      @id @default(autoincrement())
  assetId          Int      @map("asset_id")
  serviceId        Int?     @map("service_id")
  serviceName      String?  @map("service_name")
  relationshipType String   @map("relationship_type")
  createdBy        String?  @map("created_by")
  createdOn        DateTime @default(now()) @map("created_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, relationshipType])
  @@map("asset_service_relationships")
}

model AssetHistory {
  id         Int      @id @default(autoincrement())
  assetId    Int      @map("asset_id")
  actionType String   @map("action_type")
  changedBy  String?  @map("changed_by")
  changedOn  DateTime @default(now()) @map("changed_on")
  fieldName  String?  @map("field_name")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  comments   String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, changedOn])
  @@map("asset_history")
}

model AssetDynamicFieldValue {
  id                 Int      @id @default(autoincrement())
  assetId            Int      @map("asset_id")
  productTypeFieldId Int      @map("product_type_field_id")
  value              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  field ProductTypeField @relation(fields: [productTypeFieldId], references: [id])

  @@unique([assetId, productTypeFieldId])
  @@map("asset_dynamic_field_values")
}

