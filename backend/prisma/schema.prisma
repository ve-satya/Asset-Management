  numberOfCores     String?  @map("number_of_cores")
  createdOn         DateTime @default(now()) @map("created_on")
  updatedOn         DateTime @updatedAt @map("updated_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_processors")
}

model AssetHardDisk {
  id           Int      @id @default(autoincrement())
  assetId      Int      @map("asset_id")
  model        String?
  serialNumber String?  @map("serial_number")
  freeSpace    String?  @map("free_space")
  manufacturer String?
  capacity     String?
  driveType    String?  @map("drive_type")
  createdOn    DateTime @default(now()) @map("created_on")
  updatedOn    DateTime @updatedAt @map("updated_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_hard_disks")
}

model AssetKeyboard {
  id                     Int      @id @default(autoincrement())
  assetId                Int      @map("asset_id")
  keyboardType           String?  @map("keyboard_type")
  keyboardSerialNumber   String?  @map("keyboard_serial_number")
  keyboardManufacturer   String?  @map("keyboard_manufacturer")
  createdOn              DateTime @default(now()) @map("created_on")
  updatedOn              DateTime @updatedAt @map("updated_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_keyboards")
}

model AssetMonitor {
  id           Int      @id @default(autoincrement())
  assetId      Int      @map("asset_id")
  monitorType  String?  @map("monitor_type")
  resolution   String?
  serialNumber String?  @map("serial_number")
  manufacturer String?
  createdOn    DateTime @default(now()) @map("created_on")
  updatedOn    DateTime @updatedAt @map("updated_on")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_monitors")
}

model AssetMotherboard {
  id               Int      @id @default(autoincrement())
  assetId          Int      @map("asset_id")
  product          String?
  serialNumber     String?  @map("serial_number")
