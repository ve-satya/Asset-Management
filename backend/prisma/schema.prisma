generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductType {
  id                 Int       @id @default(autoincrement())
  displayName        String    @map("display_name")
  displayPluralName  String    @map("display_plural_name")
  apiName            String    @unique @map("api_name")
  apiPluralName      String    @map("api_plural_name")
  category           String    @map("category")
  assetType          String    @map("asset_type")
  assetCategory      String    @map("asset_category")
  description        String?
  parentId           Int?      @map("parent_id")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  parent   ProductType?  @relation("Hierarchy", fields: [parentId], references: [id])
  children ProductType[] @relation("Hierarchy")
  assets   Asset[]
  products Product[]
  fields   ProductTypeField[]

  @@map("product_types")
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String
  productTypeId  Int      @map("product_type_id")
  manufacturerId Int?     @map("manufacturer_id")
  partNo         String?  @map("part_no")
  cost           Float?
  isActive       Boolean  @default(true) @map("is_active")
  description    String?
  images         Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  productType  ProductType   @relation(fields: [productTypeId], references: [id])
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])
  assets       Asset[]
  vendorAssociations ProductVendorAssociation[]
  depreciationConfig ProductDepreciationConfig?

  @@map("products")
}

model ProductDepreciationConfig {
  id                  Int      @id @default(autoincrement())
  productId           Int      @unique @map("product_id")
  purchaseCost        Float    @map("purchase_cost")
  acquisitionDate     DateTime @map("acquisition_date")
  method              String
  calculationMode     String?  @map("calculation_mode")
  usefulLifeMonths    Int?     @map("useful_life_months")
  usefulLifeYears     Int?     @map("useful_life_years")
  depreciationPercent Float?   @map("depreciation_percent")
  salvageValue        Float?   @map("salvage_value")
  configuredBy        String?  @map("configured_by")
  configuredOn        DateTime @default(now()) @map("configured_on")
  updatedAt           DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_depreciation_configs")
}

model Vendor {
  id            Int      @id @default(autoincrement())
  name          String
  currency      String   @default("USD")
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  fax           String?
  website       String?
  isActive      Boolean  @default(true) @map("is_active")
  description   String?
  doorNumber    String?  @map("door_number")
  street        String?
  landmark      String?
  city          String?
  state         String?
  postalCode    String?  @map("postal_code")
  country       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  assets Asset[]
  productAssociations ProductVendorAssociation[] @relation("ProductVendor")
  maintenanceProductAssociations ProductVendorAssociation[] @relation("MaintenanceVendor")

  licenseAgreements SoftwareLicenseAgreement[]
  licenses          SoftwareLicense[]

  @@map("vendors")
}

model ProductVendorAssociation {
  id                  Int      @id @default(autoincrement())
  productId           Int      @map("product_id")
  vendorId            Int      @map("vendor_id")
  price               Float    @default(0)
  taxRate             Float?   @map("tax_rate")
  warrantyYears       Int      @default(0) @map("warranty_years")
  warrantyMonths      Int      @default(0) @map("warranty_months")
  maintenanceVendorId Int?     @map("maintenance_vendor_id")
  comments            String?
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor            Vendor  @relation("ProductVendor", fields: [vendorId], references: [id])
  maintenanceVendor Vendor? @relation("MaintenanceVendor", fields: [maintenanceVendorId], references: [id])

  @@index([productId])
  @@index([vendorId])
  @@map("product_vendor_associations")
}

model ProductTypeField {
  id                    Int      @id @default(autoincrement())
  productTypeId         Int      @map("product_type_id")
  fieldName             String   @map("field_name")
  fieldKey              String   @map("field_key")
  fieldType             String   @default("text") @map("field_type")
  required              Boolean  @default(false)
  displayOrder          Int      @default(0) @map("display_order")
  sectionName           String   @default("Details") @map("section_name")
  isInheritedToChildren Boolean  @default(true) @map("is_inherited_to_children")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  productType ProductType @relation(fields: [productTypeId], references: [id])
  values      AssetDynamicFieldValue[]

  @@unique([productTypeId, fieldKey])
  @@map("product_type_fields")
}

model SoftwareType {
  id               Int        @id @default(autoincrement())
  name             String
  description      String?
  enableCompliance Boolean    @default(false) @map("enable_compliance")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  softwares Software[]

  @@map("software_types")
}

model SoftwareCategory {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  softwares Software[]

  @@map("software_categories")
}

model SoftwareLicenseType {
  id                   Int        @id @default(autoincrement())
  name                 String
  manufacturerId       Int?       @map("manufacturer_id")
  trackBy              String?    @map("track_by")
  installationsAllowed String?    @map("installations_allowed")
  isPerpetual          Boolean    @default(false) @map("is_perpetual")
  isFreeLicense        Boolean    @default(false) @map("is_free_license")
  licenseOption        String?    @map("license_option")
  description          String?
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])
  softwares    Software[]

  @@map("software_license_types")
}

model AssetState {
  id                Int      @id @default(autoincrement())
  name              String
  description       String?
  requiresOwnership Boolean  @default(false) @map("requires_ownership")
  requiresScan      Boolean  @default(false) @map("requires_scan")
  isActive          Boolean  @default(true)  @map("is_active")
  createdAt         DateTime @default(now())  @map("created_at")
  updatedAt         DateTime @updatedAt       @map("updated_at")

  assets Asset[]

  @@map("asset_states")
}

model Manufacturer {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")

  products             Product[]
  softwareLicenseTypes SoftwareLicenseType[]
  softwares            Software[]
  licenseAgreements    SoftwareLicenseAgreement[]
  servicePacks         ServicePack[]

  @@map("manufacturers")
}

model Asset {
  id                 Int       @id @default(autoincrement())
  productTypeId      Int       @map("product_type_id")
  name               String
  assetTag           String?   @map("asset_tag")
  orgSerialNumber    String?   @map("org_serial_number")
  description        String?
  partNumber         String?   @map("part_number")
  productId          Int?      @map("product_id")
  product            String?
  vendorId           Int?      @map("vendor_id")
  vendor             String?
  barcode            String?
  manufacturer       String?
  assetStateId       Int?      @map("asset_state_id")
  assetState         String?   @map("asset_state")
  assignedUserId     Int?      @map("assigned_user_id")
  user               String?
  departmentId       Int?      @map("department_id")
  department         String?
  associatedAssetId  Int?      @map("associated_asset_id")
  associatedToAssets String?   @map("associated_to_assets")
  retainUserSiteAsAssetSite Boolean @default(false) @map("retain_user_site_as_asset_site")
  siteId             Int?      @map("site_id")
  site               String?
  region             String?
  location           String?
  isLoanable         Boolean   @default(false) @map("is_loanable")
  loanStart          DateTime? @map("loan_start")
  loanEnd            DateTime? @map("loan_end")
  comments           String?
  acquisitionDate    DateTime? @map("acquisition_date")
  expiryDate         DateTime? @map("expiry_date")
  purchaseCost       Float?    @map("purchase_cost")
  warrantyExpiryDate DateTime? @map("warranty_expiry_date")
  impactDetails      String?   @map("impact_details")
  impact             String?
  assetAudited       String?   @map("asset_audited")
  purchaseOrder      String?   @map("purchase_order")
  purchaseOrderNo    String?   @map("purchase_order_no")
  lastScanStatus     String?   @map("last_scan_status")
  lastScanTime       DateTime? @map("last_scan_time")
  scanState          String?   @map("scan_state")
  stateComments      String?   @map("state_comments")
  macAddress         String?   @map("mac_address")
  serviceTag         String?   @map("service_tag")
  domain             String?
  smbiosVersion      String?   @map("smbios_version")
  biosVersion        String?   @map("bios_version")
  biosManufacturer   String?   @map("bios_manufacturer")
  biosDate           String?   @map("bios_date")
  osName             String?   @map("os_name")
  osVersion          String?   @map("os_version")
  osBuildNumber      String?   @map("os_build_number")
  osServicePack      String?   @map("os_service_pack")
  osProductId        String?   @map("os_product_id")
  ram                String?
  virtualMemory      String?   @map("virtual_memory")
  physicalMemory     String?   @map("physical_memory")
  processors         Json?     @default("[]")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  productType ProductType @relation(fields: [productTypeId], references: [id])
  productRef  Product?    @relation(fields: [productId], references: [id])
  vendorRef   Vendor?     @relation(fields: [vendorId], references: [id])
  stateRef    AssetState? @relation(fields: [assetStateId], references: [id])
  associatedAsset Asset?  @relation("AssociatedAsset", fields: [associatedAssetId], references: [id])
  associatedAssets Asset[] @relation("AssociatedAsset")
  dynamicFieldValues AssetDynamicFieldValue[]
  history AssetHistory[]
  parentRelationships AssetRelationship[] @relation("ParentAssetRelationship")
  relatedRelationships AssetRelationship[] @relation("RelatedAssetRelationship")
  serviceRelationships AssetServiceRelationship[]
  contracts AssetContract[]
  costs AssetCost[]
  attachments AssetAttachment[]
  depreciationConfig AssetDepreciationConfig?
  computerDetails AssetComputerDetails?
  networkAdapters AssetNetworkAdapter[]
  assetProcessors AssetProcessor[]
  hardDisks AssetHardDisk[]
  keyboards AssetKeyboard[]
  monitors AssetMonitor[]
  motherboards AssetMotherboard[]
  mice AssetMouse[]
  memoryModules AssetMemoryModule[]
  userAccounts AssetUserAccount[]
  logicalDrives AssetLogicalDrive[]
  physicalDrives AssetPhysicalDrive[]
  printers AssetPrinter[]
  videoCards AssetVideoCard[]
  usbControllers AssetUsbController[]
  ports AssetPort[]
  soundCards AssetSoundCard[]
  mobileNetworks AssetMobileNetwork[]
  mobileCertificates AssetMobileCertificate[]
  printerInputUnits AssetPrinterInputUnit[]
  printerMarkerSubUnits AssetPrinterMarkerSubUnit[]
  printerOutputUnits AssetPrinterOutputUnit[]
  printerMarkerSupplyUnits AssetPrinterMarkerSupplyUnit[]
  switchPorts AssetSwitchPort[]
  deviceInterfaces AssetDeviceInterface[]
  netAppPhysicalDisks AssetNetAppPhysicalDisk[]
  netAppVolumes AssetNetAppVolume[]
  netAppAggregators AssetNetAppAggregator[]
  sensors AssetSensor[]

  @@map("assets")
}

